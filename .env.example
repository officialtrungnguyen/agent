PORT=8787

# Google OAuth (Gmail send + true scheduling).
# Until these are set, the app stays in premium simulation mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
APP_BASE_URL=http://localhost:5173

# Optional: enables live OpenAI for email + intel + advisor. Without it, the
# app uses high-fidelity offline templates that match the AI output 1:1.
OPENAI_API_KEY=
