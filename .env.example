# BulgeBracket.ai — environment configuration
# Copy to `.env.local` and fill in. All keys are OPTIONAL: the app is fully
# usable offline (rich fallback data, local drafts/queue). Adding these unlocks
# real Gmail sending and live AI enrichment.

# --- Google OAuth (real Gmail send + scheduling) ---
# Create an OAuth 2.0 Client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and enable the Gmail API.
# Authorized redirect URI must be: <your-origin>/api/gmail/callback
#   e.g. http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit redirect (otherwise derived from the request origin):
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Optional AI enrichment (email/advisor copy) ---
# Without a key, the app uses its high-fidelity offline generators.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
