# ─────────────────────────────────────────────────────────────
# BulgeBracket.ai environment configuration
# Copy this file to `.env` and fill in real values to unlock
# live Gmail send/scheduling and (optionally) live AI enrichment.
# Every feature has a high-fidelity offline fallback, so the app
# is fully usable even without any of these set.
# ─────────────────────────────────────────────────────────────

# Express API port (Vite proxies /api -> this port)
PORT=8787

# Where the frontend is served (used for OAuth redirect + CORS)
APP_ORIGIN=http://localhost:5173

# Google OAuth 2.0 credentials (Gmail send + scheduling)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <APP_ORIGIN-or-API>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# Optional: live AI enrichment (OpenAI-compatible). Leave blank to
# use the built-in premium offline intelligence engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
