# BulgeBracket.ai — environment configuration
#
# Create OAuth credentials in https://console.cloud.google.com/apis/credentials
# and add this exact authorized redirect URI:
#   http://localhost:8787/auth/google/callback
#
# Scopes used: openid, email, profile, gmail.send, gmail.compose, gmail.readonly

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional overrides
# PORT=8787
# PUBLIC_ORIGIN=http://localhost:5173
# GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback
